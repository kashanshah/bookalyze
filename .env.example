# ──────────────────────────────────────────────────────────────────────────────
# Bookalyze environment variables
#
# Local development: copy this file to `.env` in the repo root and fill it in.
#   cp .env.example .env
# Production / previews: add the same names in Vercel → Project → Settings →
# Environment Variables (never commit real values).
#
# Per-company credentials (Amazon SP-API, Wise, Noon, each eBay seller…) do NOT go here. They
# are entered inside the app under each company's Settings → Connections. Only Bookalyze's own
# app keys (Google sign-in, eBay's developer app) are set here.
# ──────────────────────────────────────────────────────────────────────────────

# ── Database (Neon Postgres) ──────────────────────────────────────────────────
# On Vercel, connect Neon from the project's Storage tab: it sets DATABASE_URL (pooled) and
# DATABASE_URL_UNPOOLED (direct) for you, both as the owner role. Nothing else to add.
# The app connects with DATABASE_URL. Tenant queries switch to the app_runtime role inside each
# transaction (withOrg), so row-level security applies even over the owner login.
DATABASE_URL=postgres://neondb_owner:PASSWORD@ep-xxxxx-pooler.REGION.aws.neon.tech/bookalyze?sslmode=require
# Migrations and seeding use DATABASE_URL_MIGRATOR, else DATABASE_URL_UNPOOLED, else DATABASE_URL.
# Use the owner role and Neon's DIRECT (non-pooled) connection string.
DATABASE_URL_MIGRATOR=postgres://neondb_owner:PASSWORD@ep-xxxxx.REGION.aws.neon.tech/bookalyze?sslmode=require
# Set by Neon's Vercel integration (direct connection). Used for migrations when
# DATABASE_URL_MIGRATOR isn't set. Leave unset locally.
# DATABASE_URL_UNPOOLED=
# GitHub Actions → Settings → Secrets: DATABASE_URL_MIGRATOR (the same Neon owner, direct string)
# lets the Deploy workflow run safe migrations before Vercel promotes a deploy.

# Database tests (pnpm test) use a separate database, so they never touch your data.
# `pnpm db:up` creates it locally. Not needed on Vercel.
TEST_DATABASE_URL=postgres://bookalyze_app:PASSWORD@localhost:5432/bookalyze_test
TEST_DATABASE_URL_MIGRATOR=postgres://bookalyze_owner:PASSWORD@localhost:5432/bookalyze_test

# ── Sign-in (Better Auth) ─────────────────────────────────────────────────────
# Random 32+ character secret. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of the app. http://localhost:3000 locally, https://app.bookalyze.com in production.
BETTER_AUTH_URL=http://localhost:3000

# ── Sign in with Google ───────────────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → Create OAuth client ID
# (type: Web application). Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://app.bookalyze.com/api/auth/callback/google
# Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email (Resend) ────────────────────────────────────────────────────────────
# resend.com → API Keys. Verify the bookalyze.com domain under Domains first.
RESEND_API_KEY=
EMAIL_FROM="Bookalyze <no-reply@bookalyze.com>"
# Forwarded invoice requests: the domain Resend receives for (MX record), and the signing
# secret of the Resend webhook for "email.received" pointing at /api/inbound/email.
INBOUND_EMAIL_DOMAIN=
RESEND_WEBHOOK_SECRET=
# true = write emails to apps/web/.dev-mail.log instead of sending (local testing only).
EMAIL_DEV_LOG=false

# ── Billing (Stripe) ──────────────────────────────────────────────────────────
# Test mode only: a live key (sk_live_…) is ignored unless STRIPE_LIVE=true, which only the
# owner sets when billing goes live. Without a key, billing is off and everything stays free.
STRIPE_SECRET_KEY=
STRIPE_LIVE=false
# Signing secret of the webhook pointing at /api/stripe/webhook.
STRIPE_WEBHOOK_SECRET=
# YYYY-MM-DD. Until this day (and while unset) every company has everything, free.
BILLING_STARTS_ON=

# ── Access ────────────────────────────────────────────────────────────────────
# invite_only (default while private) or open (public launch).
SIGNUP_MODE=invite_only
# Comma-separated emails that may always sign up (you, the platform owner).
PLATFORM_ADMIN_EMAILS=you@example.com

# ── Vercel preview deployments ────────────────────────────────────────────────
# Production URL that handles Google callbacks for preview deployments.
# Set this in Vercel for the Preview environment only, e.g. https://app.bookalyze.com
OAUTH_PROXY_PRODUCTION_URL=

# ── Receipts and documents ────────────────────────────────────────────────────
# AWS S3: a private bucket with versioning on, CORS allowing PUT from the app's origins, and an
# IAM user limited to that bucket (s3:PutObject, s3:GetObject, s3:DeleteObject). Steps: docs/SETUP.md.
AWS_REGION=ca-central-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# "s3" (default when AWS_S3_BUCKET is set) or "local" (files in apps/web/.uploads; development
# and CI only, never on Vercel).
STORAGE_DRIVER=

# ── Scheduled jobs ────────────────────────────────────────────────────────────
# Vercel Cron sends this as "Authorization: Bearer …" to /api/cron/* (daily exchange rates).
# Any long random string: openssl rand -base64 32. Set it in Vercel (Production).
CRON_SECRET=

# ── Connections (Wise, later marketplaces) ───────────────────────────────────
# Master key that encrypts each company's saved credentials. openssl rand -base64 32
# Required to connect Wise. Keep a backup somewhere safe: losing or changing it means
# reconnecting every connection (transactions already brought in are unaffected).
APP_ENCRYPTION_KEY=
# Leave unset: the Wise API. Tests point it at a local stand-in (apps/web/e2e/wise-mock.mjs).
# WISE_API_URL=

# ── eBay (Bookalyze's own eBay developer app) ─────────────────────────────────
# One app for every company; each company connects its own seller account by agreeing on eBay's
# page. Without the first three, Connect eBay says it isn't available yet. Steps: docs/SETUP.md → eBay.
# developer.ebay.com → Application Keys: App ID (Client ID) and Cert ID (Client Secret).
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# User Tokens → the redirect's RuName (not a URL). Its accepted and declined URLs are
# https://app.bookalyze.com/api/ebay/callback; its privacy policy URL is
# https://app.bookalyze.com/privacy-policy
EBAY_RU_NAME=
# Alerts & Notifications → Marketplace account deletion: a token you make up (32–80 letters,
# digits, _ or -), entered there too. Endpoint: https://app.bookalyze.com/api/ebay/account-deletion
EBAY_VERIFICATION_TOKEN=
# Leave unset for live keys (production). Set to sandbox only with Sandbox keys.
# EBAY_ENVIRONMENT=sandbox

# ── Marketplace test stand-ins ────────────────────────────────────────────────
# Leave unset: the real APIs. End-to-end tests point them at local stand-ins in apps/web/e2e/.
# AMAZON_LWA_URL=
# AMAZON_SPAPI_URL=
# NOON_API_URL=
# WALMART_API_URL=
# EBAY_AUTH_URL=
# EBAY_API_URL=
# EBAY_APIZ_URL=
